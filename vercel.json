{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "functions": {
        "app.py": {
          "maxDuration": 300,
          "excludeFiles": "{frontend/**,tests/**,scripts/**,evidencias/**,instrucoes/**,.local/**,.venv/**,.env,.env.*,**/__pycache__/**}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": { "service": "app" }
    },
    {
      "source": "/api/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
