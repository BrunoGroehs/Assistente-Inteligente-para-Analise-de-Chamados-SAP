# Copie este arquivo para .env. Nunca envie credenciais ao chat ou ao Git.
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=qwen/qwen3.6-plus
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# Supabase: conexão PostgreSQL (pooler em modo session), com SSL.
DATABASE_URL=
# Exemplo: postgresql+psycopg://usuario:senha@host:5432/postgres?sslmode=require
APP_ENV=local
# Origem pública exata, sem caminho. Para vercel dev na porta 3000:
# APP_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Na hospedagem, use https://SEU_DOMINIO. Sem valor, VERCEL_URL é usado quando disponível.
APP_PUBLIC_ORIGIN=
DEMO_ACCESS_CODE=
MAX_ANALYSES_PER_SESSION=30
